# Copy to .env (development) or set these in your host's environment (production).
# Never commit real values. .env* files are git-ignored.

NODE_ENV=development            # development | test | production
PORT=3001

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/tablenest
# MONGO_MAX_POOL_SIZE=20
# MONGO_AUTO_INDEX=true         # set false in large production DBs and run `npm run migrate` on deploy

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production: a random value of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── HTTP ────────────────────────────────────────────────────────────────────
# REQUIRED in production: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173   # used in password-reset emails
TRUST_PROXY=1                        # number of proxies in front of the API (for correct client IPs)
# RATE_LIMIT_PER_15_MIN=1500
# SWAGGER_ENABLED=false              # docs at /api/docs are on outside production by default

# ── Business ────────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=UTC                 # e.g. Africa/Kigali; restaurants can override their own
# Currency, fees, commission and plans are edited at runtime via PUT /api/admin/settings.

# ── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DRIVER=local
# UPLOAD_DIR=./uploads               # must be a persistent volume in production
# PUBLIC_UPLOAD_BASE_URL=            # e.g. https://api.example.com if the frontend is on another domain
MAX_UPLOAD_MB=5

# ── Email (optional; without it, emails are logged instead of sent) ─────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=TableNest <no-reply@example.com>
